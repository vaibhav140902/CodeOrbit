# CodeOrbit Root Monorepo Production Environment Template
# See apps/web/.env.production.example for detailed documentation of each variable.

NEXT_PUBLIC_SITE_URL=https://codeorbit.app

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south2
NEXT_PUBLIC_ENABLE_APPCHECK=false
NEXT_PUBLIC_USE_FUNCTIONS_EMULATOR=false

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Judge0
JUDGE0_URL=https://ce.judge0.com
JUDGE0_KEY=

# Administration
ADMIN_EMAILS=vaibhavmaurya.1409@gmail.com
BYPASS_PAID_ACCESS=false
