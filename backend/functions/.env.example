# -----------------------------------------------------------
# CodeOrbit backend environment variables
# File: backend/functions/.env
# These values stay SERVER-SIDE only.
# Put these in Firebase Functions secrets/env, Replit Secrets,
# or your local backend/functions/.env for emulator use.
# -----------------------------------------------------------

# Razorpay key ID for checkout creation.
# Use test key first: starts with rzp_test_...
RAZORPAY_KEY_ID=rzp_test_replace_me

# Razorpay key secret paired with the key ID above.
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Razorpay webhook signing secret used to verify payment events.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Gemini API key used for AI hints, ELI5, solver, interviews, and resume flows.
# Recommended if you are using Gemini Flash instead of OpenAI.
GEMINI_API_KEY=your_gemini_api_key

# Gemini Flash model. Current default is gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key used for AI hints, ELI5, solver, interviews, and resume flows.
# Optional if Gemini is your primary provider.
OPENAI_API_KEY=sk-your-openai-key

# OpenAI model name for chat completions.
OPENAI_MODEL=gpt-4o-mini

# Optional Grok/xAI API key if you want Grok fallback or primary routing.
GROK_API_KEY=xai-your-grok-key

# Grok model name.
GROK_MODEL=grok-2-latest

# AI provider routing strategy: gemini, openai, grok, or auto.
# If you use Gemini Flash, set this to gemini.
AI_PROVIDER=gemini

# Judge0 base URL for isolated code execution.
# MVP default can be https://ce.judge0.com or your own hosted Judge0 URL.
JUDGE0_URL=https://ce.judge0.com

# Optional Judge0 auth token header value.
# Leave blank if your Judge0 instance does not require X-Auth-Token.
JUDGE0_KEY=

# CPU time limit for code execution, in seconds.
JUDGE0_CPU_TIME_LIMIT_SECONDS=2

# Wall-clock time limit for code execution, in seconds.
JUDGE0_WALL_TIME_LIMIT_SECONDS=5

# Memory limit for code execution, in kilobytes.
JUDGE0_MEMORY_LIMIT_KB=262144

# Allow code executed by Judge0 to access the network.
# Keep false for safer coding-judge behavior.
JUDGE0_ENABLE_NETWORK=false

# Maximum number of poll attempts while waiting for Judge0 to finish.
JUDGE0_MAX_POLLS=12

# Delay between Judge0 poll attempts, in milliseconds.
JUDGE0_POLL_INTERVAL_MS=1000

# Daily quota for free-pass claims if you use the daily free unlock flow.
MAX_DAILY_FREE_USERS=100

# Enforce Firebase App Check on callable functions.
# Switch to true after App Check is fully configured in the frontend.
ENFORCE_APPCHECK=false

# Allowed frontend origins for CORS and server-side origin checks.
# Include localhost plus your final Vercel domains.
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key. Keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


SUPABASE_ANON_KEY=your_supabase_anon_key
