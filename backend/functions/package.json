{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts src",
    "build": "esbuild src/*.ts --platform=node --target=node22 --format=cjs --outdir=lib --sourcemap --packages=external",
    "postinstall": "node scripts/patch-buffer-eq.cjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@types/cors": "^2.8.17",
    "cors": "^2.8.5",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "esbuild": "^0.27.4",
    "eslint": "^8.56.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
