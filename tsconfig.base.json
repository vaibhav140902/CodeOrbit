{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@codeorbit/ui": [
        "packages/ui/src/index.ts"
      ],
      "@codeorbit/ui/mock-problems": [
        "packages/ui/src/data/mock-problems.ts"
      ],
      "@codeorbit/ui/*": [
        "packages/ui/src/*"
      ]
    }
  }
}
