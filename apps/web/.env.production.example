# ==============================================================================
# CODEORBIT PRODUCTION ENVIRONMENT MANIFEST
# ==============================================================================
# Copy this file to .env.production.local or set these variables in your hosting
# provider's dashboard (e.g. Vercel, Railway, Render, GCP Cloud Run).
# Every variable listed below is required or has production defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SITE & CANONICAL URL
# ------------------------------------------------------------------------------
# The canonical domain where your production app is hosted (no trailing slash).
# Used for absolute URL generation, OAuth redirects, and OpenGraph social cards.
NEXT_PUBLIC_SITE_URL=https://codeorbit.app

# ------------------------------------------------------------------------------
# 2. FIREBASE AUTHENTICATION (CLIENT & SERVER CRYPTO)
# ------------------------------------------------------------------------------
# These credentials connect your client-side authentication to Firebase.
# Server-side verification uses Google's public x509 certs with RS256 caching.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south2

# Firebase App Check (Set to true in production once reCAPTCHA Enterprise is registered)
NEXT_PUBLIC_ENABLE_APPCHECK=false
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Local Emulators (MUST be false in production)
NEXT_PUBLIC_USE_FUNCTIONS_EMULATOR=false

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL & REST PERSISTENCE
# ------------------------------------------------------------------------------
# Obtain from your Supabase project settings -> API.
# When configured, platform data (users, submissions, streaks, payments) persists
# to PostgreSQL with Row Level Security. When omitted, falls back to local cache.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...YourSecretServiceRoleKeyHere
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...YourPublicAnonKeyHere

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI ENGINE (15 RPM FREE TIER SHIELDED)
# ------------------------------------------------------------------------------
# API key from Google AI Studio (free tier provides 15 RPM).
# CodeOrbit's AI Shield enforces a 12 RPM sliding ceiling and sub-5ms caching.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. RAZORPAY BILLING & CRYPTOGRAPHIC WEBHOOKS
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks.
# Webhook URL to register: https://codeorbit.app/api/platform/billing/webhook
# Secret MUST match the webhook secret configured in the Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_live_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=your_high_entropy_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. JUDGE0 REMOTE CODE EXECUTION RUNNER
# ------------------------------------------------------------------------------
# Default points to the public Judge0 Community Edition endpoint (ce.judge0.com).
# For high-volume production, connect your private self-hosted Judge0 instance.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_KEY=
JUDGE0_CPU_TIME_LIMIT_SECONDS=2
JUDGE0_WALL_TIME_LIMIT_SECONDS=5
JUDGE0_MEMORY_LIMIT_KB=262144
JUDGE0_ENABLE_NETWORK=false

# ------------------------------------------------------------------------------
# 7. PLATFORM ADMINISTRATION & SECURITY ACCESS
# ------------------------------------------------------------------------------
# Comma-separated list of founder / admin emails granted full portal access.
ADMIN_EMAILS=vaibhavmaurya.1409@gmail.com,founder@codeorbit.app

# Cryptographic Candidate Proof Badge Salt (High-entropy secret for HMAC-SHA256 badge verification)
PROOF_BADGE_SALT=codeorbit_national_placement_authority_salt_2026_prod

# Paid feature bypass for local QA testing (MUST be false or unset in production)
BYPASS_PAID_ACCESS=false
