# ---------------------------------------------
# CodeOrbit web app environment variables
# File: apps/web/.env.local
# These are PUBLIC browser-side values used by the Next.js app.
# Firebase web config is intentionally public and safe to ship to the browser.
# ---------------------------------------------

# Firebase Web SDK API key for your app.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key

# Firebase Auth domain, usually "<project-id>.firebaseapp.com".
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase project ID.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage bucket, usually "<project-id>.firebasestorage.app".
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Firebase Cloud Messaging sender ID.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Firebase web app ID from Project Settings.
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Region where your callable Firebase Functions are deployed.
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south2

# reCAPTCHA v3 site key used by Firebase App Check on the web.
# Leave blank until you enable App Check.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Enable Firebase App Check in the browser.
# Use "true" only after NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY is added.
NEXT_PUBLIC_ENABLE_APPCHECK=false

# Optional App Check debug token for local development.
# Use "auto" or a real debug token only for local/dev environments.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Set to "true" only when using the local Firebase Functions emulator.
NEXT_PUBLIC_USE_FUNCTIONS_EMULATOR=false

# Hostname for the Firebase Functions emulator.
NEXT_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1

# Port for the Firebase Functions emulator.
NEXT_PUBLIC_FUNCTIONS_EMULATOR_PORT=5001

# ---------------------------------------------
# Server-only AI vars for Next.js route handlers on Vercel.
# These must be added to the web app environment, but they are NOT exposed to the browser.
# ---------------------------------------------

# Gemini API key used by /api/ai/* routes.
GEMINI_API_KEY=your_gemini_api_key

# Gemini model for Smart Hint, mock interviews, and ATS resume generation.
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------
# Supabase PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
