{
  "name": "codeorbit-workspace",
  "private": true,
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev --workspace @codeorbit/web",
    "start:web": "npm run start --workspace @codeorbit/web",
    "build": "turbo run build",
    "build:web": "npm run build --workspace @codeorbit/web",
    "lint": "turbo run lint",
    "lint:web": "npm run lint --workspace @codeorbit/web",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "npm run typecheck --workspace @codeorbit/web",
    "legacy:frontend": "echo 'Error: Legacy Vite SPA (frontend/) is permanently decommissioned. Run \"npm run dev:web\" to launch Next.js 15 on Port 3001.' && exit 1",
    "legacy:functions": "npm run serve --prefix backend/functions"
  },
  "devDependencies": {
    "turbo": "^2.8.17",
    "typescript": "^5.9.3"
  }
}
